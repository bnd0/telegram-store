# PostgreSQL — get from Supabase > Project Settings > Database
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# Redis — get from Upstash > Database > REST URL & Token
REDIS_URL=rediss://default:PASSWORD@xxxx.upstash.io:6379

# App
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,https://your-telegram-app.vercel.app
